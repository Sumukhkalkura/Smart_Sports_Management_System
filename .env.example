# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Main application connection (owner of the schema)
DB_NAME=smart_sports
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SELECT-only role used by the DBMS Lab query editor.
# Created/updated by: python manage.py setup_readonly_role
DB_READONLY_USER=sports_readonly
DB_READONLY_PASSWORD=change-me-readonly
